/* ==========================================================================
   RMA - Perfil moderno a 1 columna con identidad cromática por sección
   Uso: --formato secciones  |  formato: secciones (en metadatos/revista.yaml)
   Paleta unificada WCAG AA/AAA sincronizada con CSS_OJS_MAESTRA (data-seccion)
   ========================================================================== */

:root {
    /* Capa 1: Base editorial compartida en toda la revista */
    --rma-bg: #FAF9F6;
    --rma-surface: #F2EFE9;
    --rma-text: #21201E;
    --rma-text-muted: #59554E;
    --rma-border: #D8D2C7;

    /* Capa 2: Valores por defecto (Antropología Social) */
    --rma-primary: #264966;
    --rma-primary-soft: #92ABC0;
    --rma-accent: #8A4F19;
    --rma-highlight: #DFE8F2;
}

/* --- IDENTIDAD CROMÁTICA POR SECCIÓN (atributo data-seccion en <body>) --- */
body[data-seccion="arqueologia"],
body.perfil-secciones.sec-arqueologia {
    --rma-primary: #8B3A2B;      /* Terracota */
    --rma-primary-soft: #C99A90;
    --rma-accent: #1F5E66;       /* Azul pizarra */
    --rma-highlight: #F4E3D7;    /* Arcilla tenue */
}

body[data-seccion="biologica"],
body.perfil-secciones.sec-biologica,
body.perfil-secciones.sec-bioantropologia {
    --rma-primary: #234E52;      /* Verde petróleo */
    --rma-primary-soft: #8FB3B6;
    --rma-accent: #8C4A27;       /* Siena óseo */
    --rma-highlight: #DCECE9;    /* Agua pálida */
}

body[data-seccion="social"],
body.perfil-secciones.sec-social,
body.perfil-secciones.sec-antropologia-social {
    --rma-primary: #264966;      /* Azul índigo */
    --rma-primary-soft: #92ABC0;
    --rma-accent: #8A4F19;       /* Ocre tostado */
    --rma-highlight: #DFE8F2;    /* Celeste grisáceo */
}

body[data-seccion="museologia"],
body.perfil-secciones.sec-museologia {
    --rma-primary: #4B3B5A;      /* Púrpura pizarra */
    --rma-primary-soft: #A89CB4;
    --rma-accent: #2A5C4E;       /* Salvia oscuro */
    --rma-highlight: #EAE4F0;    /* Lavanda humo */
}

body[data-seccion="dossier"],
body[data-tipo="dossier"],
body.perfil-secciones.sec-dossier,
body.perfil-secciones.sec-dosier {
    --rma-primary: #732638;      /* Borravino editorial */
    --rma-primary-soft: #BD919B;
    --rma-accent: #785216;       /* Bronce antiguo */
    --rma-highlight: #F3E1E5;    /* Rosa antiguo tenue */
}

/* Mapeo de tokens unificados hacia las variables del layout paginado */
body.perfil-secciones {
    --sec-accent: var(--rma-primary);
    --sec-accent-soft: var(--rma-primary-soft);
    --sec-tint: var(--rma-surface);
    --sec-tint-alt: var(--rma-bg);
    --sec-tint-strong: var(--rma-highlight);
    --sec-border: var(--rma-border);
}

/* --- CONFIGURACIÓN DE PÁGINA --- */
@page {
    size: A4 portrait;
    margin: 22mm 22mm 21mm 22mm;
    @bottom-center {
        content: string(running-issn) "\A" counter(page);
        white-space: pre-line;
        text-align: center;
        font-family: "Liberation Sans", "DejaVu Sans", Arial, sans-serif;
        font-size: 7.5pt;
        line-height: 1.45;
        color: #555555;
        vertical-align: top;
        padding-top: 2mm;
    }
    @footnote {
        border-top: 0.6pt solid #8a7f72;
        padding-top: 2mm;
        margin-top: 3mm;
    }
}

@page :left {
    @top-center {
        content: element(header-left);
        width: 100%;
        vertical-align: bottom;
    }
}

@page :right {
    @top-center {
        content: element(header-right);
        width: 100%;
        vertical-align: bottom;
    }
}

@page :first {
    margin-top: 13mm;
    margin-bottom: 27mm;
    @top-center { content: none; }
    @bottom-center {
        content: element(pie-p1);
        width: 100%;
        vertical-align: top;
    }
}

.running-header-left {
    position: running(header-left);
    width: 100%;
    box-sizing: border-box;
    text-align: left;
    font-family: "Liberation Sans", "DejaVu Sans", Arial, sans-serif;
    font-size: 7.5pt;
    line-height: 1.28;
    color: #4a4a4a;
    border-bottom: 0.6pt solid var(--sec-accent-soft);
    padding-bottom: 1.6mm;
    margin-bottom: 3mm;
}
.running-header-right {
    position: running(header-right);
    width: 100%;
    box-sizing: border-box;
    text-align: right;
    font-family: "Liberation Sans", "DejaVu Sans", Arial, sans-serif;
    font-size: 7.5pt;
    line-height: 1.28;
    color: #4a4a4a;
    border-bottom: 0.6pt solid var(--sec-accent-soft);
    padding-bottom: 1.6mm;
    margin-bottom: 3mm;
}
.running-header-left .rh-linea,
.running-header-right .rh-linea {
    display: block;
}
.running-header-left a,
.running-header-right a {
    color: inherit;
    text-decoration: none;
    border-bottom: none;
}
.meta-running-issn {
    string-set: running-issn content();
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
    font-size: 1pt;
}

body {
    font-family: "Liberation Sans", "DejaVu Sans", Arial, sans-serif;
    font-size: 10pt;
    line-height: 1.46;
    color: #1f2328;
    margin: 0;
}

a {
    color: var(--sec-accent);
    text-decoration: none;
    border-bottom: 0.4pt solid var(--sec-accent-soft);
}

/* Citas hipervinculadas en celeste tradicional */
a.cita-enlace {
    color: #0066cc;
    text-decoration: none;
    border-bottom: none;
}

/* --- PIE INSTITUCIONAL EXCLUSIVO DE PÁGINA 1 --- */
.pie-primera-pagina {
    position: running(pie-p1);
    border-top: 1.1pt solid var(--sec-accent);
    background-color: var(--sec-tint-alt);
    padding: 2mm 2.5mm;
    font-size: 6.7pt;
    line-height: 1.28;
    color: #2c3138;
    width: 100%;
    box-sizing: border-box;
}
.pie-p1-grid {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 3mm;
    width: 100%;
}
.pie-p1-cc {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
}
.pie-p1-cc a {
    border-bottom: none;
}
.logo-cc-img {
    height: 6.2mm;
    width: auto;
    display: block;
}
.pie-p1-centro {
    flex: 1 1 auto;
    text-align: center;
}
.pie-p1-centro p {
    margin: 0;
}
.pie-p1-centro .cita-biblio-p1 {
    font-weight: 700;
    color: #181c20;
}
.pie-p1-editores {
    flex: 0 0 auto;
    text-align: right;
    max-width: 46mm;
    font-size: 6.8pt;
    line-height: 1.25;
    color: #1f2328;
}
.pie-p1-editores p {
    margin: 0;
}
.pie-p1-editores .editor-principal {
    font-weight: 700;
    color: var(--sec-accent);
}

/* --- PORTADA / PRIMERA PÁGINA --- */
.cabezal-revista {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    background-color: var(--sec-tint-alt);
    border: 0.5pt solid var(--sec-border);
    border-bottom: 2pt solid var(--sec-accent);
    border-radius: 3pt 3pt 0 0;
    padding: 3mm 4mm;
    margin-bottom: 4.5mm;
}

.marca-rma-vertical {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    min-width: 24mm;
}
.logo-rma-img {
    height: 13.5mm;
    width: auto;
    display: block;
    margin-bottom: 1mm;
}
.sigla-rma {
    font-weight: 900;
    font-size: 13pt;
    line-height: 1.05;
    letter-spacing: 0.8pt;
    color: #181818;
}
.seccion-rma {
    font-weight: 700;
    font-size: 7.3pt;
    text-transform: uppercase;
    letter-spacing: 0.5pt;
    background-color: var(--sec-accent);
    color: #ffffff;
    padding: 0.7mm 2.2mm;
    border-radius: 2pt;
    margin-top: 1mm;
}

.datos-cabezal-der {
    text-align: right;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1mm;
}
.nombre-revista-cabezal {
    font-size: 9.5pt;
    font-weight: 700;
    color: #2b2f36;
}
.edicion-cabezal {
    font-size: 8pt;
    color: #464c54;
}
.issn-cabezal {
    font-size: 7pt;
    color: #606670;
}
.doi-rma {
    font-size: 8pt;
    font-weight: 600;
    background-color: var(--sec-tint-strong);
    padding: 0.8mm 2.2mm;
    border-radius: 2pt;
    color: #2b2f36;
}
.doi-rma a {
    color: var(--sec-accent);
    border-bottom: none;
}

.bloque-titulos {
    margin-bottom: 4mm;
}
.titulo-es {
    font-size: 16.5pt;
    line-height: 1.2;
    font-weight: 700;
    color: #14171a;
    margin: 0 0 2.2mm 0;
    text-align: left;
}
.acento-titulo {
    width: 24mm;
    height: 1.8pt;
    background-color: var(--sec-accent);
    margin: 0 0 2.2mm 0;
}
.titulo-en {
    font-size: 11.5pt;
    line-height: 1.26;
    font-style: italic;
    font-weight: 400;
    color: #424852;
    margin: 0;
    text-align: left;
}

.bloque-autoria {
    background-color: #f4f6f8;
    border-left: 2.5pt solid var(--sec-accent);
    padding: 2.5mm 3.5mm;
    margin-bottom: 4mm;
    border-radius: 0 2.5pt 2.5pt 0;
}
.autores {
    font-size: 10pt;
    font-weight: 700;
    color: #182026;
    margin-bottom: 1.5mm;
}
.afiliaciones {
    margin: 0;
}
.afil {
    font-size: 7.6pt;
    line-height: 1.3;
    margin: 0 0 0.7mm 0;
    color: #363d45;
}
.afil:last-child {
    margin-bottom: 0;
}

.bloque-resumenes {
    background-color: var(--sec-tint);
    border: 0.5pt solid var(--sec-border);
    border-left: 3.5pt solid var(--sec-accent);
    border-radius: 0 3pt 3pt 0;
    padding: 3.2mm 4.2mm;
    margin: 0 0 4.5mm 0;
    font-size: 8.7pt;
    line-height: 1.36;
    text-align: justify;
}
.bloque-resumenes h3 {
    font-size: 9pt;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.4pt;
    margin: 0 0 1mm 0;
    color: var(--sec-accent);
}
.bloque-resumenes p {
    margin: 0 0 1.6mm 0;
}
.bloque-resumenes .keywords {
    font-size: 8.2pt;
    color: #333840;
    margin-bottom: 0;
}
hr.divisor-resumen {
    border: none;
    border-top: 0.5pt solid var(--sec-border);
    margin: 2.4mm 0;
}

hr.divisor-portada {
    border: none;
    border-top: 1pt solid var(--sec-border);
    margin: 0 0 4mm 0;
}

/* --- CUERPO A UNA COLUMNA --- */
.cuerpo-articulo {
    text-align: justify;
    hyphens: auto;
    overflow-wrap: break-word;
}

.cuerpo-articulo h2 {
    font-size: 11.5pt;
    line-height: 1.25;
    font-weight: 700;
    text-align: left;
    color: #181c20;
    border-top: 0.6pt solid var(--sec-border);
    padding-top: 2.5mm;
    margin: 5.5mm 0 2mm 0;
    break-after: avoid;
    page-break-after: avoid;
    hyphens: none;
}
.cuerpo-articulo > h2:first-child {
    border-top: none;
    padding-top: 0;
    margin-top: 0;
}

.cuerpo-articulo p {
    margin: 0 0 3mm 0;
    orphans: 2;
    widows: 2;
}

.cuerpo-articulo p.fecha-manuscrito {
    text-align: right;
    font-style: italic;
    font-size: 8.8pt;
    color: #4a5058;
    margin-top: 4mm;
    hyphens: none;
}

blockquote {
    margin: 3.5mm 8mm;
    padding: 1.5mm 3mm;
    border-left: 2pt solid var(--sec-accent);
    background-color: var(--sec-tint-alt);
    font-size: 9pt;
    line-height: 1.38;
    color: #2c3138;
    orphans: 2;
    widows: 2;
}

span.footnote {
    float: footnote;
    font-size: 7.8pt;
    line-height: 1.26;
    text-align: left;
    hyphens: none;
}
::footnote-call {
    content: counter(footnote);
    font-size: 68%;
    vertical-align: super;
    line-height: none;
    color: var(--sec-accent);
    font-weight: bold;
}
::footnote-marker {
    content: counter(footnote) ". ";
    font-size: 7.8pt;
    font-weight: bold;
    color: var(--sec-accent);
}
.fn-ref-link, .notas-al-pie-html {
    display: none;
}

/* --- FIGURAS Y TABLAS EN 1 COLUMNA --- */
.rma-figura {
    break-inside: avoid;
    page-break-inside: avoid;
    margin: 6mm auto 6.5mm auto;
    padding: 3mm 3.5mm;
    background-color: var(--sec-tint-alt);
    border: 0.5pt solid var(--sec-border);
    border-radius: 2.5pt;
    hyphens: none;
}
.rma-tabla {
    margin: 6mm auto 6.5mm auto;
    padding: 3mm 3.5mm;
    background-color: var(--sec-tint-alt);
    border: 0.5pt solid var(--sec-border);
    border-radius: 2.5pt;
    hyphens: none;
}
.rma-tabla.tabla-indivisible {
    break-inside: avoid;
    page-break-inside: avoid;
}
.rma-tabla.tabla-divisible {
    break-inside: auto;
    page-break-inside: auto;
}
.rma-tabla.tabla-fragmento-continua {
    margin-bottom: 2.2mm;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}
.rma-tabla.tabla-fragmento-continuacion {
    margin-top: 2mm;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
}
.tabla-cont-sup {
    font-size: 7.8pt;
    font-style: italic;
    color: var(--sec-accent);
    text-align: left;
    margin-bottom: 1.5mm;
    break-after: avoid;
    page-break-after: avoid;
}
.tabla-cont-inf {
    font-size: 7.8pt;
    font-style: italic;
    color: var(--sec-accent);
    text-align: right;
    margin-top: 1.5mm;
    break-before: avoid;
    page-break-before: avoid;
}
.ancho-completo {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
}
.ancho-centrado,
.ancho-columna {
    width: 74%;
    max-width: 100%;
    box-sizing: border-box;
}

.rma-figura img {
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 98mm;
    object-fit: contain;
    margin: 0 auto;
    display: block;
    border: 0.3pt solid var(--sec-border);
}
.rma-figura.ancho-completo img {
    max-height: 114mm;
}

figcaption, .tabla-caption {
    font-size: 8.3pt;
    line-height: 1.32;
    text-align: left;
    margin-top: 3.8mm;
    padding-top: 2.2mm;
    border-top: 0.4pt solid var(--sec-border);
    color: #2b3036;
    break-inside: avoid;
    page-break-inside: avoid;
}
figcaption {
    break-before: avoid;
    page-break-before: avoid;
}
.cap-es, .cap-en {
    display: block;
    margin-bottom: 0.8mm;
}

.rma-tabla table {
    width: 100%;
    max-width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
    font-size: 8.1pt;
    line-height: 1.26;
    text-align: left;
    background-color: #ffffff;
    overflow-wrap: break-word;
    word-wrap: break-word;
}
.rma-tabla thead {
    display: table-header-group;
}
.rma-tabla tr {
    break-inside: avoid;
    page-break-inside: avoid;
}
.rma-tabla th, .rma-tabla td {
    border-top: 0.5pt solid #666666;
    border-bottom: 0.5pt solid #666666;
    padding: 1.3mm 1.6mm;
    vertical-align: top;
    overflow-wrap: break-word;
    word-wrap: break-word;
}
.rma-tabla th {
    background-color: var(--sec-tint-strong);
    font-weight: 700;
    color: #181c20;
}

.rma-tabla.tabla-compacta table {
    font-size: 7pt;
    line-height: 1.2;
}
.rma-tabla.tabla-compacta th,
.rma-tabla.tabla-compacta td {
    padding: 1mm 1.1mm;
}
.rma-tabla.tabla-densa table {
    font-size: 6pt;
    line-height: 1.16;
}
.rma-tabla.tabla-densa th,
.rma-tabla.tabla-densa td {
    padding: 0.75mm 0.8mm;
}
.rma-tabla.tabla-micro table {
    font-size: 5.3pt;
    line-height: 1.14;
}
.rma-tabla.tabla-micro th,
.rma-tabla.tabla-micro td {
    padding: 0.6mm 0.55mm;
}

.tabla-notas {
    font-size: 7.5pt;
    line-height: 1.24;
    margin-top: 2.4mm;
    text-align: left;
    color: #424852;
    break-inside: avoid;
}

/* --- REFERENCIAS BIBLIOGRÁFICAS --- */
.referencias .ref-item {
    padding-left: 6mm;
    text-indent: -6mm;
    font-size: 8.8pt;
    line-height: 1.34;
    text-align: left;
    margin: 0 0 2mm 0;
    orphans: 2;
    widows: 2;
    hyphens: none;
    overflow-wrap: break-word;
}

.par-figuras-columnas {
    display: flex;
    gap: 6mm;
    align-items: flex-start;
    width: 100%;
    margin: 6mm auto 6.5mm auto;
    break-inside: avoid;
    page-break-inside: avoid;
}
.par-figuras-columnas > .rma-figura {
    flex: 1 1 0;
    min-width: 0;
    margin: 0;
}

.enlace-id {
    display: inline-block;
    vertical-align: middle;
    text-decoration: none;
    border-bottom: none;
    margin-left: 0.8mm;
    line-height: 1;
}
.icono-orcid {
    width: 3.1mm;
    height: 3.1mm;
    vertical-align: -0.5mm;
    display: inline-block;
}
.icono-ror {
    height: 3.1mm;
    width: auto;
    vertical-align: -0.5mm;
    display: inline-block;
}
